# ───────────────────────────────────────────────────────────
# Casino Project — environment template (copy to .env)
# ⚠️ Demo project. No real money / payment integration.
# ───────────────────────────────────────────────────────────

# Database (shared Postgres)
DATABASE_URL="postgresql://casino:casino@localhost:5432/casino?schema=public"

# Redis (rate limiting, OTP throttling, wallet→backend balance pub/sub)
REDIS_URL="redis://localhost:6379"

# JWT — secrets MUST be identical across auth/wallet/backend (shared verification)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Service ports
GATEWAY_PORT=8080
AUTH_PORT=4001
WALLET_PORT=4002
BACKEND_PORT=4000

# Upstream URLs (used by api-gateway to fan out /api/*)
AUTH_SERVICE_URL="http://localhost:4001"
WALLET_SERVICE_URL="http://localhost:4002"
BACKEND_SERVICE_URL="http://localhost:4000"

# Gateway pattern: shared secret stamped by the gateway and (optionally) enforced
# by upstream services so they can only be reached THROUGH the gateway.
# Leave empty in local dev to allow direct service access.
GATEWAY_SECRET=""

# CORS — comma-separated allowed origins (read by every service + gateway)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Wallet limits (MINOR units = cents)
WITHDRAWAL_FEE_BPS=150
MIN_DEPOSIT_MINOR=500
MAX_DEPOSIT_MINOR=10000000
MIN_WITHDRAWAL_MINOR=1000
MAX_WITHDRAWAL_MINOR=5000000

# Bet limits (MINOR units = cents)
MIN_BET_MINOR=10
MAX_BET_MINOR=100000

# ── Game Aggregator ──
# Master key for AES-256-GCM encryption of provider credentials at rest.
CREDENTIAL_ENC_KEY="change-me-credential-encryption-key-32b"
# Public base URL providers use to reach our callbacks (the gateway origin).
PUBLIC_BASE_URL="http://localhost:8080"
# Provider credentials (seed the encrypted Provider rows on first boot).
PGSOFT_API_KEY="pgsoft-dev-key"
PGSOFT_SECRET="pgsoft-dev-secret"
PGSOFT_ENDPOINT="https://api.pgsoft.example/v2"
PRAGMATIC_API_KEY="pragmatic-dev-key"
PRAGMATIC_SECRET="pragmatic-dev-secret"
PRAGMATIC_ENDPOINT="https://api.pragmaticplay.example/v1"
EVOLUTION_API_KEY="evolution-dev-key"
EVOLUTION_SECRET="evolution-dev-secret"
EVOLUTION_ENDPOINT="https://api.evolution.example/api"
JILI_API_KEY="jili-dev-key"
JILI_SECRET="jili-dev-secret"
JILI_ENDPOINT="https://api.jili.example/game"

# Node env
NODE_ENV="development"

# ── Frontend (frontend/.env) ──
# VITE_API_URL="/api"                         # proxied to the gateway in dev
# VITE_SOCKET_URL="/"                         # proxied to backend :4000
# VITE_GATEWAY_URL="http://localhost:8080"    # vite dev proxy target for /api
# VITE_BACKEND_URL="http://localhost:4000"    # vite dev proxy target for /socket.io
