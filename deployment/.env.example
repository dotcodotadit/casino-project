# ───────────────────────────────────────────────────────────
# Casino Project — PRODUCTION env template
# Copy to deployment/.env and fill in strong secrets.
# ⚠️ Demo / educational. No real money or payment integration.
# ───────────────────────────────────────────────────────────

# Public domain (used for CORS + nginx server_name + SSL)
DOMAIN=casino.example.com
CORS_ORIGINS=https://casino.example.com,https://admin.casino.example.com

# ── Postgres ──
POSTGRES_USER=casino
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=casino

# ── Secrets (MUST be identical across auth/wallet/backend/gateway) ──
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

# Gateway → upstream shared secret (enables the "only via gateway" guard).
# Generate: openssl rand -hex 32
GATEWAY_SECRET=change-me-gateway-shared-secret

# ── Tuning ──
LOG_LEVEL=info
BCRYPT_ROUNDS=12

# Bet / wallet limits (MINOR units = cents)
MIN_BET_MINOR=10
MAX_BET_MINOR=100000
WITHDRAWAL_FEE_BPS=150
